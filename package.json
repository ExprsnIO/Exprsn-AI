{
  "name": "exprsn-ai",
  "private": true,
  "version": "1.6.0",
  "description": "Self-hosted, multi-tenant control plane and chat interface for Ollama-served models.",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": ["server"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm start -w server",
    "lint": "npm run lint -w server",
    "typecheck": "npm run typecheck -w server",
    "docs:permissions": "npm run docs:permissions -w server",
    "test": "npm test -w server",
    "loadtest": "npm run loadtest -w server --",
    "loadtest:platform": "npm run loadtest:platform -w server --",
    "test:e2e": "npm ci --prefix e2e && npm test --prefix e2e"
  }
}
