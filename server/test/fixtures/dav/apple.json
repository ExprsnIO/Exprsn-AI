{
  "client": "Apple Calendar and Contacts (macOS 15, dataaccessd and AddressBookSourceSync)",
  "userAgent": "macOS/15.0 (24A335) dataaccessd/1.0",
  "note": "Request shapes as Apple's clients send them: discovery through /.well-known, the principal's homes, getctag and sync-token on the home, sync-collection, multiget, a VEVENT time-range query, the 'incomplete reminders' VTODO query and the Contacts search.",
  "exchanges": [
    { "name": "discovery", "request": { "method": "PROPFIND", "path": "/.well-known/caldav", "headers": { "Depth": "0" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:propfind xmlns:A=\"DAV:\"><A:prop><A:current-user-principal/><A:principal-URL/><A:resourcetype/></A:prop></A:propfind>" }, "response": { "status": 301 } },
    { "name": "root", "request": { "method": "PROPFIND", "path": "/dav/", "headers": { "Depth": "0" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:propfind xmlns:A=\"DAV:\"><A:prop><A:current-user-principal/><A:principal-URL/><A:resourcetype/></A:prop></A:propfind>" }, "response": { "status": 207, "contains": ["<d:current-user-principal><d:href>/dav/principals/{uid}/</d:href>"] } },
    { "name": "principal", "request": { "method": "PROPFIND", "path": "/dav/principals/{uid}/", "headers": { "Depth": "0" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:propfind xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:caldav\" xmlns:C=\"http://calendarserver.org/ns/\"><A:prop><B:calendar-home-set/><B:calendar-user-address-set/><A:current-user-principal/><A:displayname/><C:email-address-set/><B:schedule-inbox-URL/><B:schedule-outbox-URL/><A:principal-collection-set/><A:supported-report-set/></A:prop></A:propfind>" }, "response": { "status": 207, "contains": ["<cal:calendar-home-set><d:href>/dav/calendars/{uid}/</d:href>", "mailto:alice@example.test", "<cal:schedule-inbox-URL/>"] } },
    { "name": "home", "request": { "method": "PROPFIND", "path": "/dav/calendars/{uid}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:propfind xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:caldav\" xmlns:C=\"http://calendarserver.org/ns/\" xmlns:D=\"http://apple.com/ns/ical/\"><A:prop><C:getctag/><A:sync-token/><B:supported-calendar-component-set/><D:calendar-color/><D:calendar-order/><A:displayname/><A:resourcetype/><A:current-user-privilege-set/><B:calendar-description/><A:owner/></A:prop></A:propfind>" }, "response": { "status": 207, "hrefs": ["/dav/calendars/{uid}/", "{cal}/"], "contains": ["<cal:comp name=\"VEVENT\"/>", "<d:privilege><d:write/></d:privilege>"] } },
    { "name": "sync, initial", "capture": "token", "request": { "method": "REPORT", "path": "{cal}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:sync-collection xmlns:A=\"DAV:\"><A:sync-token/><A:sync-level>1</A:sync-level><A:prop><A:getetag/><A:getcontenttype/></A:prop></A:sync-collection>" }, "response": { "status": 207, "hrefs": ["{cal}/e1.ics", "{cal}/e2.ics", "{cal}/e3.ics", "{cal}/e4.ics", "{cal}/e5.ics", "{cal}/t1.ics", "{cal}/t2.ics"] } },
    { "name": "multiget", "request": { "method": "REPORT", "path": "{cal}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><B:calendar-multiget xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:caldav\"><A:prop><A:getetag/><B:calendar-data/></A:prop><A:href>{cal}/e1.ics</A:href><A:href>{cal}/e2.ics</A:href><A:href>{cal}/missing.ics</A:href></B:calendar-multiget>" }, "response": { "status": 207, "hrefs": ["{cal}/e1.ics", "{cal}/e2.ics", "{cal}/missing.ics"], "contains": ["SUMMARY:Board meeting", "missing.ics</d:href><d:status>HTTP/1.1 404 Not Found</d:status>"] } },
    { "name": "time-range on VEVENT (comp-filter, time-range with start and end)", "operators": ["comp-filter", "time-range"], "request": { "method": "REPORT", "path": "{cal}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><B:calendar-query xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:caldav\"><A:prop><A:getetag/></A:prop><B:filter><B:comp-filter name=\"VCALENDAR\"><B:comp-filter name=\"VEVENT\"><B:time-range start=\"20261101T000000Z\" end=\"20261201T000000Z\"/></B:comp-filter></B:comp-filter></B:filter></B:calendar-query>" }, "response": { "status": 207, "hrefs": ["{cal}/e1.ics", "{cal}/e2.ics", "{cal}/e5.ics"] } },
    { "name": "incomplete reminders (prop-filter is-not-defined)", "operators": ["comp-filter", "prop-filter", "is-not-defined"], "request": { "method": "REPORT", "path": "{cal}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><B:calendar-query xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:caldav\"><A:prop><A:getetag/></A:prop><B:filter><B:comp-filter name=\"VCALENDAR\"><B:comp-filter name=\"VTODO\"><B:prop-filter name=\"COMPLETED\"><B:is-not-defined/></B:prop-filter></B:comp-filter></B:comp-filter></B:filter></B:calendar-query>" }, "response": { "status": 207, "hrefs": ["{cal}/t1.ics"] } },
    { "name": "Contacts: discovery", "request": { "method": "PROPFIND", "path": "/.well-known/carddav", "headers": { "Depth": "0" }, "body": "" }, "response": { "status": 301 } },
    { "name": "Contacts: home", "request": { "method": "PROPFIND", "path": "/dav/addressbooks/{uid}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><A:propfind xmlns:A=\"DAV:\" xmlns:B=\"urn:ietf:params:xml:ns:carddav\" xmlns:C=\"http://calendarserver.org/ns/\"><A:prop><A:resourcetype/><A:displayname/><C:getctag/><A:sync-token/><B:max-resource-size/><A:current-user-privilege-set/></A:prop></A:propfind>" }, "response": { "status": 207, "hrefs": ["/dav/addressbooks/{uid}/", "{dir}/", "{book}/"], "contains": ["<card:addressbook/>"] } },
    { "name": "Contacts: search by name (text-match, contains, unicode-casemap)", "operators": ["prop-filter", "text-match", "match-type:contains", "collation:i;unicode-casemap"], "request": { "method": "REPORT", "path": "{book}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><C:addressbook-query xmlns:A=\"DAV:\" xmlns:C=\"urn:ietf:params:xml:ns:carddav\"><A:prop><A:getetag/><C:address-data/></A:prop><C:filter><C:prop-filter name=\"FN\"><C:text-match collation=\"i;unicode-casemap\" match-type=\"contains\">ÉMILE</C:text-match></C:prop-filter></C:filter></C:addressbook-query>" }, "response": { "status": 207, "hrefs": ["{book}/c2.vcf"], "contains": ["FN:Émile Zola"] } },
    { "name": "Contacts: directory search never returns a contact above the caller's clearance", "operators": ["prop-filter", "text-match", "match-type:ends-with"], "request": { "method": "REPORT", "path": "{dir}/", "headers": { "Depth": "1" }, "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><C:addressbook-query xmlns:A=\"DAV:\" xmlns:C=\"urn:ietf:params:xml:ns:carddav\"><A:prop><A:getetag/></A:prop><C:filter><C:prop-filter name=\"EMAIL\"><C:text-match match-type=\"ends-with\">@example.test</C:text-match></C:prop-filter></C:filter></C:addressbook-query>" }, "response": { "status": 207, "hrefs": ["{dir}/{uid}.vcf", "{dir}/{bob}.vcf"], "absent": ["{dir}/{carol}.vcf"] } }
  ]
}
