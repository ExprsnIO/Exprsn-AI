{
  "description": "Shared canonical JSON vectors for Exprsn token signatures (sigVersion 2). The same file lives in exprsn-platform services/ca/tests/fixtures/ and Exprsn-AI server/test/fixtures/; both implementations must produce `expected` byte for byte. `token` is a v2 token payload (the object minus checksum/signature); `tokenCanonical` its canonical form, `tokenChecksum` sha256 hex of it, `tokenSignature` an RSA-PSS SHA-256 (salt 32) signature of it by the throwaway key whose public half is `tokenPublicKey`.",
  "vectors": [
    {
      "name": "scalars",
      "input": [
        null,
        true,
        false,
        0,
        0,
        1,
        -1,
        0.1,
        1e+21,
        1.5e-7,
        123456789012345,
        "",
        "a"
      ],
      "expected": "[null,true,false,0,0,1,-1,0.1,1e+21,1.5e-7,123456789012345,\"\",\"a\"]"
    },
    {
      "name": "top-level keys sorted",
      "input": {
        "b": 1,
        "a": 2,
        "c": 3
      },
      "expected": "{\"a\":2,\"b\":1,\"c\":3}"
    },
    {
      "name": "nested keys sorted at every depth",
      "input": {
        "z": {
          "y": {
            "b": 1,
            "a": [
              {
                "d": 1,
                "c": 2
              }
            ]
          },
          "x": {}
        },
        "a": []
      },
      "expected": "{\"a\":[],\"z\":{\"x\":{},\"y\":{\"a\":[{\"c\":2,\"d\":1}],\"b\":1}}}"
    },
    {
      "name": "keys sort by UTF-16 code units",
      "input": {
        "€": 1,
        "😀": 2,
        "z": 3,
        "Z": 4,
        "é": 5,
        "aa": 6,
        "a": 7,
        "": 8
      },
      "expected": "{\"\":8,\"Z\":4,\"a\":7,\"aa\":6,\"z\":3,\"é\":5,\"€\":1,\"😀\":2}"
    },
    {
      "name": "string escapes",
      "input": {
        "s": "quote\" backslash\\ nl\n tab\t ctrl\u0001 slash/ unié"
      },
      "expected": "{\"s\":\"quote\\\" backslash\\\\ nl\\n tab\\t ctrl\\u0001 slash/ unié\"}"
    },
    {
      "name": "nested objects are not emptied",
      "input": {
        "issuer": {
          "domain": "ca.example",
          "certificateSerial": "0A1B"
        },
        "permissions": {
          "read": true,
          "write": false
        }
      },
      "expected": "{\"issuer\":{\"certificateSerial\":\"0A1B\",\"domain\":\"ca.example\"},\"permissions\":{\"read\":true,\"write\":false}}"
    }
  ],
