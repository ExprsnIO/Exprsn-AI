# Local development settings. Load with: set -a; . server/.env; set +a
NODE_ENV=development
PORT=8080
PUBLIC_URL=http://localhost:8080
DB_CLIENT=sqlite
SQLITE_FILENAME=./data/exprsn-ai.sqlite
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -base64 32: the local KMS master key that wraps each tenant's data key
DATA_KEY=
# KMS_PROVIDER=openbao OPENBAO_ADDR=https://bao.internal:8200 OPENBAO_TOKEN=...
# Exports, attachments and audit checkpoints
BLOB_DIR=./data/blobs
# Optional: Redis for the BullMQ job queue and more than one instance
# REDIS_URL=redis://localhost:6379
# Optional: SMTP for notification email, and a SIEM endpoint for the audit stream
# SMTP_URL=smtp://user:pass@mail.internal:587
# SIEM_URL=https://siem.internal/services/collector/raw
# IDENTITY_CONFIG=../deploy/config/identity.example.yaml
# Secret references in user stores and upstream IdPs: env: names (or PREFIX*) they may read, and the directories
# file: references must resolve inside. The server's own settings and secret files are never readable.
# SECRET_REF_ENV=IDP_*
# SECRET_REF_DIRS=/run/secrets,/run/credentials,/etc/exprsn-ai/credentials
# LDAP/SQL user stores and data connections must be internal hosts unless these lists (hosts, *.domain, CIDRs) name them
# IDENTITY_ALLOWED_HOSTS=
# CONNECTIONS_ALLOWED_HOSTS=
LOG_LEVEL=info
# Optional: MCP servers outside the internal ranges (hosts, *.domains or CIDRs), and the script sandbox
# MCP_ALLOWED_HOSTS=
# SCRIPT_RUNNER=podman
# Optional (Sprint 8): workflows' HTTP steps call private addresses only; narrow them further with a host list
# WORKFLOW_HTTP_HOSTS=.corp.internal,kb.internal
# Optional (Sprint 8): media worker binaries, caps, and whisper.cpp for transcripts
# MEDIA_FFMPEG=ffmpeg MEDIA_FFPROBE=ffprobe MEDIA_ENCODER=auto
# MEDIA_MAX_BYTES=536870912 MEDIA_MAX_DURATION_S=7200 MEDIA_MAX_WIDTH=1920 MEDIA_MAX_HEIGHT=1080 MEDIA_MAX_STREAMS=4
# MEDIA_WHISPER_BIN=/opt/whisper.cpp/whisper-cli MEDIA_WHISPER_MODEL=/opt/whisper.cpp/models/ggml-large-v3.bin
# Optional (Sprint 8): image workers and the image-safety classifier
# IMAGE_BACKENDS=[{"id":"comfyui-sdxl","kind":"comfyui","url":"http://comfyui.internal:8188","model":"sdxl-base","workflow":"/etc/exprsn-ai/sdxl.json"}]
# IMAGE_SAFETY_URL=http://safety.internal:8080/classify
# Optional (Sprint 14): how old a DPoP proof may be, in seconds. With KMS_PROVIDER=openbao, OIDC and SAML signing
# keys live in transit (<OPENBAO_KEY_PREFIX>fed-<kid>); the token then also needs create, read and sign on them.
# DPOP_PROOF_MAX_AGE_SECONDS=60

# Sprint 11: account self-service (docs/deploy.md)
# STEPUP_WINDOW_SECONDS=300
# BREACHED_PASSWORDS=off            # off | hibp | file | both
# BREACHED_HIBP_URL=https://api.pwnedpasswords.com
# BREACHED_TIMEOUT_MS=3000
# BREACHED_FILE=/etc/exprsn-ai/pwned-passwords-sha1-ordered-by-hash.txt
# PASSWORD_RESET_MINUTES=60
# PASSWORD_RESET_PER_HOUR=5
# PASSWORD_INVITE_HOURS=72
# Optional (Sprint 12): a streaming answer whose instance is silent this long is marked interrupted (and can be
# continued); how often each tenant's conversation retention policy is applied (0 turns it off)
# CHAT_STREAM_LEASE_SECONDS=30
# CHAT_RETENTION_SWEEP_MINUTES=60
# Optional (Sprint 16): the guard model checks streamed answers in the background; hold-back is how many screened
# sentences may wait for its verdict before generation pauses (0: shown at once, a verdict stops only later ones);
# the most background checks per instance; anonymous share links opened per address per minute
# CHAT_GUARD_HOLDBACK_SENTENCES=1
# CHAT_GUARD_STREAM_CONCURRENCY=16
# SHARE_ANONYMOUS_PER_MINUTE=30

# Optional (Sprint 13): the OpenAI-compatible API at /v1 streams checked answers (or live tokens)
# OPENAI_STREAM_MODE=checked
# Optional (Sprint 13): webhooks reach internal hosts only unless listed here; retries, backoff and the breaker
# WEBHOOK_ALLOWED_HOSTS=
# WEBHOOK_TIMEOUT_MS=10000 WEBHOOK_MAX_ATTEMPTS=6 WEBHOOK_RETRY_BASE_MS=30000
# WEBHOOK_BREAKER_THRESHOLD=5 WEBHOOK_BREAKER_COOLDOWN_MS=300000
# Optional (Sprint 13): billing statements; push a finished month to Stripe as an invoice
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_key
# STRIPE_API_URL=https://api.stripe.com STRIPE_DAYS_UNTIL_DUE=30
# BILLING_CLOSE_MINUTES=360

# Optional (Sprint 15): changing the key-encryption key: old key here, then run `exprsn-ai kms:rewrap`
# DATA_KEY_PREVIOUS=
# KMS_PREVIOUS_PROVIDER=local
# Optional (Sprint 15): clock skew against NTP, sandboxed media from a second host name, OpenBao database credentials
# NTP_SERVER=ntp.corp.internal
# MEDIA_ORIGIN=https://media.ai.corp.internal
# OPENBAO_DATABASE_MOUNT=database
# Optional (Sprint 15): mandatory bundle scan and staging; blob store in backups (default on)
# PLATFORM_BUNDLE_REQUIRE_CHECKS=true
# PLATFORM_BACKUP_BLOBS=true
# Optional (Sprint 15): ACME dns-01 through a signed webhook or RFC 2136, and the certificate file sink
# ACME_CHALLENGE=dns-01
# ACME_DNS_PROVIDER=rfc2136 ACME_DNS_RFC2136_SERVER=10.31.0.53 ACME_DNS_RFC2136_ZONE=corp.internal
# ACME_DNS_TSIG_NAME=acme-update. ACME_DNS_TSIG_SECRET=<base64>
# ACME_DNS_PROVIDER=webhook ACME_DNS_WEBHOOK_URL=http://dns-hook.corp.internal/acme ACME_DNS_WEBHOOK_SECRET=<32+ chars>
# ACME_CERT_DIR=/etc/exprsn-ai/certs
# Optional (Sprint 19): knowledge replication, the Stripe webhook, required image safety, gVisor for scripts
# KNOWLEDGE_REPLICATION=on KNOWLEDGE_REPLICATION_TICK_MS=10000
# STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# IMAGE_SAFETY_REQUIRED=true
# SCRIPT_RUNTIME=runsc
# Optional (Sprint 18): operator-chosen service URLs (pool instances, zone endpoints, image backends, the trainer).
# Loopback and private addresses are allowed; metadata, link-local and unspecified addresses are refused. This list
# admits a link-local network (never a metadata address) and, with SERVICE_INTERNAL_ONLY=true, public hosts.
# SERVICE_ALLOWED_HOSTS=169.254.20.0/24
# SERVICE_INTERNAL_ONLY=false
# Optional (Sprint 18): in production, refuse plaintext PostgreSQL/MySQL, Redis, S3 and OpenBao links
# REQUIRE_BACKEND_TLS=true
# BACKEND_TLS_EXEMPT=redis
# Optional (Sprint 18): ACME external account binding, RFC 2136 transport, certificate reload commands
# ACME_EAB_KID=kid-from-the-ca ACME_EAB_HMAC_KEY_FILE=/run/secrets/acme_eab_hmac
# ACME_DNS_RFC2136_TRANSPORT=auto
# ACME_RELOAD_COMMANDS={"nginx":["/usr/sbin/nginx","-s","reload"]}
# ACME_HOOK_TIMEOUT_MS=30000
# Optional (Sprint 18): training worker contract 2 (sealed rows, platform-held artefacts), mTLS both ways
# TRAINER_CALLBACK_URL=https://ai.corp.internal
# TRAINER_PLAINTEXT_FALLBACK=false
# TRAINER_KEY_TTL_SECONDS=900
# TRAINER_CLIENT_CERT_SHA256=AB:CD:...
# TRAINER_ARTIFACT_MAX_BYTES=68719476736
# TRAINER_CA_FILE=/etc/exprsn-ai/trainer-ca.pem TRAINER_CERT_FILE=/etc/exprsn-ai/trainer-client.pem TRAINER_KEY_FILE=/etc/exprsn-ai/trainer-client.key
# Optional (Sprint 17): identity and security (docs/deploy.md). New-sign-in notices; DPoP server nonces and the API's
# public base behind a proxy prefix (the DPoP htu); how often fetched SAML metadata is refreshed.
# SIGNIN_NOTICES=true
# DPOP_NONCES=false
# DPOP_NONCE_SECONDS=300
# API_PUBLIC_URL=https://gateway.example.internal/ai
# FEDERATION_METADATA_REFRESH_HOURS=24
# Optional (Sprint 20): the signer process holds the local key-encryption key and the OIDC, SAML and webhook private
# keys (run `exprsn-ai signer` as its own user with SIGNER_KEY_FILE and SIGNER_TOKEN_FILE; docs/deploy.md). With it,
# leave DATA_KEY unset here. In production DATA_KEY may only come from DATA_KEY_FILE.
# SIGNER_SOCKET=/run/exprsn-signer/signer.sock SIGNER_TOKEN_FILE=/etc/exprsn-ai/credentials/signer_token
# SIGNER_TIMEOUT_MS=5000
# HTTP_SIGNATURE_MAX_AGE_SECONDS=300
# Optional (Sprint 21): how often due agent schedules are looked for (a schedule fires at most this late)
# AGENT_SCHEDULE_TICK_SECONDS=60
# Optional (Sprint 22): OpenTelemetry tracing over OTLP/HTTP JSON (spans to <endpoint>/v1/traces; no tenant content)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...
# OTEL_SERVICE_NAME=exprsn-ai
# OTEL_TRACES_SAMPLE_RATIO=1
# OTEL_BSP_MAX_QUEUE_SIZE=2048
# OTEL_BSP_SCHEDULE_DELAY=5000
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# Optional (Sprint 22): the schema version handshake interval (an instance older than the database takes no jobs)
# SCHEMA_CHECK_SECONDS=30
# Optional (Sprint 22): apply zone NetworkPolicies through the Kubernetes API and report drift
# ZONES_APPLY=kubernetes
# ZONES_APPLY_API_URL=https://kubernetes.default.svc
# ZONES_APPLY_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# ZONES_APPLY_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# ZONES_APPLY_FIELD_MANAGER=exprsn-ai
# ZONES_APPLY_DRIFT_MINUTES=15
# Optional (Sprint 22): several NTP servers give a median skew and name outliers; Redis probe for the rate-limit warning
# NTP_SERVER=ntp1.corp.internal,ntp2.corp.internal,ntp3.corp.internal
# NTP_OUTLIER_MS=1000
# RATELIMIT_PROBE_SECONDS=15
# Optional (Sprint 23): knowledge sources that fetch over HTTP (own S3-compatible endpoints, internal web sites).
# Internal addresses only, unless named here; link-local and metadata addresses never.
# KNOWLEDGE_ALLOWED_HOSTS=minio.storage.internal,*.amazonaws.com
# KNOWLEDGE_FETCH_TIMEOUT_MS=30000
# Optional (Sprint 24): versions a new vault KV secret keeps (each secret's metadata can change it, 1 to 100)
# VAULT_KV_MAX_VERSIONS=10
# Optional (Sprint 25): database leases (built-in PostgreSQL and MySQL engines) and vault rotation notices
# VAULT_LEASE_DEFAULT_TTL_SECONDS=3600
# VAULT_LEASE_MAX_TTL_SECONDS=86400
# VAULT_LEASE_SWEEP_SECONDS=60
# VAULT_ROTATION_CHECK_MINUTES=60
# VAULT_ROTATION_NOTICE_DAYS=7
# Optional (Sprint 24): the certificate authority. Its keys live in the signer (SIGNER_SOCKET) or OpenBao transit
# (KMS_PROVIDER=openbao); without either it makes no keys. Certificates name these URLs for CRLs, OCSP and issuers.
# PKI_PUBLIC_URL=https://ca.example.org
# PKI_CRL_MINUTES=60
# PKI_CRL_VALIDITY_HOURS=24
# PKI_OCSP_VALIDITY_MINUTES=60
# PKI_OCSP_CACHE_SECONDS=300
# PKI_OCSP_SIGNER_DAYS=30
# PKI_PUBLIC_RATE_PER_MINUTE=600
# Optional (1.4.0, Sprint 24c): the tenant-scoped read-through cache. auto: Redis when REDIS_URL is set, else memory.
# Invalidations travel on the bus, so every instance drops a changed entry.
# CACHE_STORE=auto
# CACHE_TTL_SHORT_SECONDS=10
# CACHE_TTL_MEDIUM_SECONDS=60
# CACHE_TTL_LONG_SECONDS=600
# CACHE_MAX_ENTRIES=10000
# Optional (1.4.0, Sprint 25d): plugins that run. Events reach a plugin as jobs, at most PLUGIN_RATE_PER_MINUTE a
# minute and PLUGIN_CONCURRENCY at once per plugin; a chain of plugin-caused events stops at PLUGIN_MAX_DEPTH. Script
# handlers run in the script sandbox (SCRIPT_RUNNER) with these limits, and only from a signed import bundle unless
# PLUGINS_REQUIRE_SIGNED says otherwise (scripts | all | none).
# PLUGIN_RATE_PER_MINUTE=120
# PLUGIN_CONCURRENCY=2
# PLUGIN_MAX_DEPTH=3
# PLUGIN_SCRIPT_TIMEOUT_SECONDS=30
# PLUGIN_SCRIPT_MEMORY_MB=256
# PLUGIN_MAX_CALLS=50
# PLUGINS_REQUIRE_SIGNED=scripts
