{
  "name": "@exprsn-ai/server",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "exprsn-ai": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:permissions": "tsx test/permissions-doc.ts --write",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "loadtest": "tsx loadtest/stream.ts",
    "loadtest:platform": "tsx loadtest/platform.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "imapflow": "^2.2.5",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "ldapts": "^9.2.0",
    "mailparser": "^3.9.36",
    "mongodb": "7.7.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.1",
    "re2": "^1.27.0",
    "socket.io": "^4.8.4",
    "ulid": "^3.0.2",
    "undici": "^8.11.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
