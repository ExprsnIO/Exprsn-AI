        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (provider, le) (rate(exprsn_cloud_wait_seconds_bucket{job=~\"$job\"}[10m])))",
