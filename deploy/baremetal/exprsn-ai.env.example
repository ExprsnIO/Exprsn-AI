# /etc/exprsn-ai/exprsn-ai.env — non-secret settings (secrets are systemd credentials; see exprsn-ai.service).
PUBLIC_URL=https://ai.example.internal
HOST=127.0.0.1
PORT=8080
# The TLS reverse proxy in front of this host (nginx, HAProxy). Use its address, or "loopback" when on this host.
TRUST_PROXY=loopback
# pg (recommended), mysql, or sqlite for a single small node.
DB_CLIENT=pg
# SQLITE_FILENAME=/var/lib/exprsn-ai/exprsn-ai.sqlite
DEFAULT_TENANT=default
# Exports, attachments and audit checkpoints (filesystem), or BLOB_STORE=s3 with S3_ENDPOINT, S3_BUCKET,
# S3_ACCESS_KEY_ID and the S3_SECRET_ACCESS_KEY credential.
BLOB_DIR=/var/lib/exprsn-ai/blobs
# KMS: local (DATA_KEY credential) or openbao (OPENBAO_ADDR plus the OPENBAO_TOKEN credential).
KMS_PROVIDER=local
# OPENBAO_ADDR=https://bao.internal:8200
# Redis enables the BullMQ queue and running several instances behind a load balancer.
# REDIS_URL=redis://127.0.0.1:6379
# SMTP_URL=smtp://mail.internal:587
# SMTP_FROM=Exprsn-AI <ai@example.internal>
# SIEM_URL=https://siem.internal/services/collector/raw
IDENTITY_CONFIG=/etc/exprsn-ai/identity.yaml
LOG_LEVEL=info
# Values referenced by identity.yaml as env:NAME. Prefer file:/etc/exprsn-ai/credentials/... references instead.
# Every env: name must be allowed here (names or PREFIX*); the server's own settings never are.
# SECRET_REF_ENV=HR_PG_URL,PARTNER_MYSQL_URL,LAB_SQLITE_PATH
# HR_PG_URL=postgres://hr_readonly:...@hr-db.internal:5432/hr?sslmode=verify-full
